# =====================================================
# あおいレールプランナー - 環境変数テンプレート
# コピーして .env を作成し、実際の値を入力してください。
# .env は .gitignore に追加してコミットしないこと。
# =====================================================

# --- Azure Functions ---
API_BASE_URL=https://YOUR-FUNC-APP.azurewebsites.net/api
FUNC_KEY=YOUR_FUNCTION_KEY_HERE

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_KEY=YOUR_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Cosmos DB ---
COSMOS_ENDPOINT=https://YOUR_COSMOS.documents.azure.com:443/
COSMOS_KEY=YOUR_COSMOS_PRIMARY_KEY
COSMOS_DB=aoi_rail_db
COSMOS_CONTAINER=layouts

# --- マネタイズ ---
# アフィリエイトリンクのベースURL（もしもアフィリエイト等）
AFFILIATE_BASE_URL=https://af.moshimo.com/af/c/click?a_id=YOUR_ID&p_id=170&pc_id=185&pl_id=4062&url=https%3A%2F%2Fwww.amazon.co.jp%2Fs%3Fk%3D

# --- MAU管理（動画広告切り替えフラグ） ---
# 1000以上で動画広告を有効化
CURRENT_MAU=0
