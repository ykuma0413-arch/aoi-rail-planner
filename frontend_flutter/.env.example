# Flutter ビルド定数 (--dart-define で注入)
# ビルドコマンド例:
#   flutter run \
#     --dart-define=API_BASE_URL=https://YOUR-FUNC.azurewebsites.net/api \
#     --dart-define=FUNC_KEY=YOUR_KEY
#
# CI/CD (GitHub Actions) 例:
#   flutter build apk \
#     --dart-define=API_BASE_URL=${{ secrets.API_BASE_URL }} \
#     --dart-define=FUNC_KEY=${{ secrets.FUNC_KEY }}

API_BASE_URL=https://YOUR-FUNC-APP.azurewebsites.net/api
FUNC_KEY=YOUR_FUNCTION_KEY_HERE
